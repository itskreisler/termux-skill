---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

const cmdGroups = [
  {
    name: 'Device Info',
    commands: [
      'termux-battery-status',
      'termux-audio-info',
      'termux-wifi-connectioninfo',
      'termux-wifi-scaninfo',
      'termux-telephony-deviceinfo',
      'termux-telephony-cellinfo',
      'termux-sensor -l',
      'termux-sensor -s <sensor> -n 1',
    ],
  },
  {
    name: 'Camera & Media',
    commands: [
      'termux-camera-info',
      'termux-camera-photo -c <id> <file.jpg>',
      'termux-microphone-record -f <file>',
      'termux-media-player play <file>',
      'termux-tts-speak "text"',
      'termux-tts-engines',
    ],
  },
  {
    name: 'Notifications & Feedback',
    commands: [
      'termux-notification -t "title" -c "content"',
      'termux-notification-remove --id <id>',
      'termux-toast "message"',
      'termux-vibrate -d <ms>',
      'termux-torch on/off',
      'termux-dialog',
    ],
  },
  {
    name: 'Communication',
    commands: [
      'termux-sms-list -l 10',
      'termux-sms-send -n <number> "message"',
      'termux-contact-list',
      'termux-call-log -l 10',
      'termux-telephony-call <number>',
    ],
  },
  {
    name: 'Clipboard & Location',
    commands: [
      'termux-clipboard-get',
      'termux-clipboard-set "text"',
      'termux-location',
      'termux-location -p gps',
      'termux-location -p network',
    ],
  },
  {
    name: 'System & Storage',
    commands: [
      'termux-volume',
      'termux-brightness <0-255>',
      'termux-wallpaper -f <file>',
      'termux-wake-lock',
      'termux-wake-unlock',
      'termux-share -a send <file>',
      'termux-open <file>',
      'termux-open-url <url>',
      'termux-download <url>',
      'termux-storage-get <dest>',
    ],
  },
];
---

<Layout>
  <main class="text-sm leading-relaxed px-6 py-12 lg:w-1/2 lg:pl-12 lg:pr-8 lg:py-16">

    <!-- Logo -->
    <pre id="ascii-logo" class="text-[6px] sm:text-xs lg:text-[9px] leading-none mb-8 h-[6lh] overflow-hidden" aria-hidden="true"></pre>

    <h1 class="text-zinc-400 mb-8">
      Control Android devices via Termux API.<br/>
      Auto-detects direct access or falls back to SSH.
    </h1>

    <!-- Install command -->
    <div class="mb-12">
      <p class="text-zinc-600 mb-2 uppercase tracking-widest text-xs">Try it now</p>
      <div class="flex items-center gap-3 bg-zinc-900/80 border border-zinc-800 px-4 py-3 w-fit cursor-pointer group" id="install-cmd">
        <span class="text-zinc-600">$</span>
        <span class="text-zinc-100">npx -y termux-skill</span>
        <button
          class="ml-6 text-zinc-600 hover:text-zinc-300 transition-colors"
          aria-label="Copy command"
          id="copy-btn"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Terminal panel -->
    <div class="mb-16 lg:fixed lg:top-0 lg:right-0 lg:w-1/2 lg:h-screen lg:mb-0 lg:flex lg:flex-col lg:p-8 xl:p-12 lg:border-l lg:border-zinc-800/50 lg:z-10">
      <p class="text-zinc-600 mb-2 uppercase tracking-widest text-xs lg:hidden">Output</p>
      <div class="border border-zinc-800 bg-zinc-950 lg:w-full lg:rounded-lg lg:overflow-hidden lg:shadow-2xl lg:shadow-black/20 lg:flex lg:flex-col lg:max-h-full lg:h-full" id="terminal">
        <div class="flex items-center gap-1.5 px-3 py-2 border-b border-zinc-800 shrink-0">
          <span class="w-2.5 h-2.5 rounded-full bg-zinc-800"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-zinc-800"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-zinc-800"></span>
        </div>
        <div class="p-4 text-xs leading-relaxed overflow-x-auto overflow-y-auto whitespace-pre h-[420px] lg:h-auto lg:min-h-0 lg:flex-1" id="term-body"></div>
      </div>
    </div>

    <!-- Separator -->
    <div class="mb-12 h-0.5 w-full bg-zinc-700"></div>

    <!-- What is termux-skill -->
    <div class="mb-12">
      <p class="text-zinc-600 mb-6 uppercase tracking-widest text-xs">What is termux-skill</p>
      <div class="space-y-4">
        <div class="flex gap-4">
          <span class="text-zinc-600 shrink-0">[1]</span>
          <div>
            <p class="text-zinc-200">Install for any AI agent</p>
            <p class="text-zinc-500">Run <span class="text-zinc-400">npx -y termux-skill</span> and the skill is ready for your agent (OpenCode, Claude Code, Cursor, etc.).</p>
          </div>
        </div>
        <div class="flex gap-4">
          <span class="text-zinc-600 shrink-0">[2]</span>
          <div>
            <p class="text-zinc-200">Automatic environment detection</p>
            <p class="text-zinc-500">If running in native Termux, binaries are used directly from PATH. If in proot-distro, access via <span class="text-zinc-400">/data/data/com.termux/files/usr/bin/</span>. If remote, falls back to SSH on port 8022.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <span class="text-zinc-600 shrink-0">[3]</span>
          <div>
            <p class="text-zinc-200">70+ device APIs</p>
            <p class="text-zinc-500">Camera, sensors, GPS, SMS, notifications, clipboard, TTS, torch, WiFi, battery, and more — all from your terminal.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Separator -->
    <div class="mb-12 h-0.5 w-full bg-zinc-700"></div>

    <!-- API Commands Reference -->
    <div class="mb-12">
      <p class="text-zinc-600 mb-6 uppercase tracking-widest text-xs">API Commands Reference</p>
      <div class="space-y-0">
        {cmdGroups.map((group) => (
          <div class="group border-b border-zinc-800/40 py-2.5 first:border-t">
            <div class="flex items-start gap-3">
              <div class="flex items-center gap-2 w-32 shrink-0 pt-px">
                <span class="text-zinc-300 group-hover:text-zinc-100 transition-colors text-xs">{group.name}</span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap gap-x-3 gap-y-0.5">
                  {group.commands.map((cmd) => (
                    <span class="text-xs text-zinc-600">{cmd}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Separator -->
    <div class="mb-12 h-0.5 w-full bg-zinc-700"></div>

    <!-- Footer -->
    <footer class="text-zinc-600 space-y-6 pb-8">
      <div class="space-y-2">
        <p class="text-zinc-500 uppercase tracking-widest text-xs">Flags</p>
        <div class="flex flex-wrap gap-x-8 gap-y-1.5 text-xs">
          <kbd class="text-zinc-400 bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded font-mono">termux-skill</kbd>
          <span class="text-zinc-600">Install or update</span>
        </div>
        <div class="flex flex-wrap gap-x-8 gap-y-1.5 text-xs">
          <kbd class="text-zinc-400 bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded font-mono">--update</kbd>
          <span class="text-zinc-600">Force reinstall</span>
        </div>
        <div class="flex flex-wrap gap-x-8 gap-y-1.5 text-xs">
          <kbd class="text-zinc-400 bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded font-mono">--uninstall</kbd>
          <span class="text-zinc-600">Remove skill from all agents</span>
        </div>
        <div class="flex flex-wrap gap-x-8 gap-y-1.5 text-xs">
          <kbd class="text-zinc-400 bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded font-mono">--version</kbd>
          <span class="text-zinc-500">/</span>
          <kbd class="text-zinc-400 bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded font-mono">-v</kbd>
          <span class="text-zinc-600">Show version</span>
        </div>
        <div class="flex flex-wrap gap-x-8 gap-y-1.5 text-xs">
          <kbd class="text-zinc-400 bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded font-mono">--help</kbd>
          <span class="text-zinc-500">/</span>
          <kbd class="text-zinc-400 bg-zinc-900 border border-zinc-800 px-1.5 py-0.5 rounded font-mono">-h</kbd>
          <span class="text-zinc-600">Show help</span>
        </div>
      </div>
      <p>
        <a href="https://github.com/itskreisler/termux-skill" target="_blank" rel="noopener" class="text-zinc-500 underline underline-offset-2 decoration-zinc-700 hover:decoration-zinc-400 hover:text-zinc-300 transition-colors">github</a>
      </p>
    </footer>

  </main>

  <script>
    // ── Copy button ───────────────────────────────────────────
    document.getElementById('copy-btn')?.addEventListener('click', async () => {
      await navigator.clipboard.writeText('npx -y termux-skill')
      const btn = document.getElementById('copy-btn')
      if (btn) {
        btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`
        setTimeout(() => {
          btn.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`
        }, 2000)
      }
    })

    document.getElementById('install-cmd')?.addEventListener('click', async (e) => {
      if ((e.target as HTMLElement).closest('#copy-btn')) return
      await navigator.clipboard.writeText('npx -y termux-skill')
    })

    // ── ASCII logo animation ─────────────────────────────────
    {
      const LOGO_LINES = [
        ' ████████╗███████╗██████╗ ███╗   ███╗██╗   ██╗██╗  ██╗',
        ' ╚══██╔══╝██╔════╝██╔══██╗████╗ ████║██║   ██║██║ ██╔╝',
        '    ██║   █████╗  ██████╔╝██╔████╔██║██║   ██║█████╔╝ ',
        '    ██║   ██╔══╝  ██╔══██╗██║╚██╔╝██║██║   ██║██╔═██╗ ',
        '    ██║   ███████╗██║  ██║██║ ╚═╝ ██║╚██████╔╝██║  ██╗',
        '    ╚═╝   ╚══════╝╚═╝  ╚═╝╚═╝     ╚═╝ ╚═════╝ ╚═╝  ╚═╝',
      ]

      const START_COLOR = '#3f3f46'
      const END_COLOR = '#f4f4f5'

      const logo = document.getElementById('ascii-logo')!
      const cols = Math.max(...LOGO_LINES.map(l => l.length))
      const rows = LOGO_LINES.length

      const grid: HTMLSpanElement[][] = []
      for (const line of LOGO_LINES) {
        const row: HTMLSpanElement[] = []
        const lineEl = document.createElement('div')
        lineEl.style.height = '1lh'
        for (let c = 0; c < cols; c++) {
          const ch = line[c] ?? ' '
          const span = document.createElement('span')
          span.textContent = ch
          span.style.color = START_COLOR
          lineEl.appendChild(span)
          row.push(span)
        }
        logo.appendChild(lineEl)
        grid.push(row)
      }

      const maxDist = cols + rows
      const SPEED = 0.9
      let frame = 0
      const totalFrames = Math.ceil((maxDist + 10) / SPEED)

      function animate() {
        const waveFront = frame * SPEED
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < grid[r].length; c++) {
            const dist = c + r * 3
            const progress = Math.max(0, Math.min(1, (waveFront - dist) / 10))
            const gray = Math.round(63 + progress * (244 - 63))
            grid[r][c].style.color = `rgb(${gray},${gray},${gray})`
          }
        }
        frame++
        if (frame <= totalFrames) {
          requestAnimationFrame(animate)
        } else {
          for (let r = 0; r < rows; r++)
            for (let c = 0; c < grid[r].length; c++)
              grid[r][c].style.color = END_COLOR
        }
      }
      requestAnimationFrame(animate)
    }

    // ── Terminal animation ────────────────────────────────────
    const C = {
      z4: 'color:#a1a1aa',
      z5: 'color:#71717a',
      z6: 'color:#52525b',
      z7: 'color:#3f3f46',
      cy: 'color:#22d3ee',
      c3: 'color:#67e8f9',
      em: 'color:#34d399',
      wh: 'color:#f4f4f5',
      gn: 'color:#22c55e',
      yw: 'color:#facc15',
      pk: 'color:#f472b6',
    }

    function s(style: string, text: string) {
      return `<span style="${style}">${text}</span>`
    }

    type Step = { html: string; delay: number; class?: string } | { type: 'char'; text: string; target: string; charDelay: number; delay: number }

    const BANNER = [
      s(C.cy, '   ╔═══════════════════════════════════════╗'),
      s(C.cy, '   ║') + s(C.yw, '   termux-skill') + s(C.z6, '  v1.0.6') + '   ' + s(C.cy, '║'),
      s(C.cy, '   ║') + s(C.z5, '   Termux API skill for AI agents     ') + s(C.cy, '║'),
      s(C.cy, '   ║') + s(C.z5, '   Control Android via Termux API     ') + s(C.cy, '║'),
      s(C.cy, '   ╚═══════════════════════════════════════╝'),
    ]

    const SKILL_CONTENT = [
      { line: '## Environment Detection', style: C.wh },
      { line: '', style: '' },
      { line: '$ if command -v termux-battery-status &>/dev/null; then', style: C.z5 },
      { line: '>   echo "Native Termux — binaries in PATH"', style: C.z6 },
      { line: '$ elif [ -d /data/data/com.termux/files/usr/bin ]; then', style: C.z5 },
      { line: '>   echo "proot-distro — /data/data/.../termux-*"', style: C.z6 },
      { line: '$ else', style: C.z5 },
      { line: '>   echo "No direct access — use SSH port 8022"', style: C.z6 },
      { line: '$ fi', style: C.z5 },
      { line: '', style: '' },
      { line: '## API Commands', style: C.wh },
      { line: '', style: '' },
      { line: 'termux-battery-status        Battery info', style: C.z4 },
      { line: 'termux-camera-photo          Take photo', style: C.z4 },
      { line: 'termux-notification          Show notification', style: C.z4 },
      { line: 'termux-location              Get GPS', style: C.z4 },
      { line: 'termux-sms-send              Send SMS', style: C.z4 },
      { line: 'termux-clipboard-get         Get clipboard', style: C.z4 },
      { line: 'termux-tts-speak             Text to speech', style: C.z4 },
      { line: 'termux-torch                 Toggle flashlight', style: C.z4 },
      { line: 'termux-wifi-scaninfo         Scan WiFi', style: C.z4 },
      { line: 'termux-sensor -l             List sensors', style: C.z4 },
      { line: '', style: '' },
      { line: '✔ Skill ready — 70+ APIs available', style: C.gn },
    ]

    function buildSteps(): Step[] {
      const steps: Step[] = []
      const d = (delay: number, html: string, cls?: string) =>
        steps.push({ html, delay, class: cls })

      steps.push({ type: 'char', text: '$ npx -y termux-skill', target: 'cmd-line', charDelay: 60, delay: 400 })

      d(500, '')
      for (const line of BANNER) d(30, line)
      d(0, '')
      d(400, s(C.cy, '   ▸ ') + s(C.wh, 'termux-skill: loaded'))
      d(200, '')
      for (const item of SKILL_CONTENT) {
        d(60, item.line)
      }
      d(400, '')
      d(0, s(C.pk, '   Run npx -y termux-skill to get this skill in your terminal'))

      return steps
    }

    async function sleep(ms: number) {
      return new Promise(r => setTimeout(r, ms))
    }

    async function runAnimation() {
      const body = document.getElementById('term-body')!
      body.innerHTML = ''

      const steps = buildSteps()

      for (const step of steps) {
        if ('type' in step && step.type === 'char') {
          const line = document.createElement('p')
          line.id = step.target
          body.appendChild(line)
          const cursor = '<span class="animate-pulse" style="' + C.z4 + '">▋</span>'
          for (let i = 0; i < step.text.length; i++) {
            const ch = step.text[i]
            const sofar = step.text.slice(0, i + 1)
            const colored = sofar.startsWith('$ ')
              ? '<span style="' + C.z6 + '">$ </span><span style="' + C.z4 + '">' + sofar.slice(2) + '</span>'
              : sofar
            line.innerHTML = colored + cursor
            await sleep(step.charDelay)
          }
          line.innerHTML = '<span style="' + C.z6 + '">$ </span><span style="' + C.z4 + '">npx -y termux-skill</span>'
          await sleep(step.delay)
          continue
        }

        const { html, delay } = step as { html: string; delay: number; class?: string }

        const line = document.createElement('p')
        line.innerHTML = html || '&nbsp;'
        if ((step as any).class) line.className = (step as any).class
        body.appendChild(line)
        body.scrollTop = body.scrollHeight
        if (delay > 0) await sleep(delay)
      }
    }

    const terminal = document.getElementById('terminal')
    const isDesktop = window.matchMedia('(min-width: 1024px)').matches

    async function loop() {
      while (true) {
        await runAnimation()
        await sleep(4000)
      }
    }

    if (isDesktop) {
      loop()
    } else if (terminal) {
      let running = false
      const observer = new IntersectionObserver(async (entries) => {
        if (entries[0].isIntersecting && !running) {
          running = true
          observer.disconnect()
          loop()
        }
      }, { threshold: 0.3 })
      observer.observe(terminal)
    }
  </script>
</Layout>
